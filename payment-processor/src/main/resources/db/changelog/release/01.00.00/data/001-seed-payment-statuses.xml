<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">
    <changeSet id="PAYMENTS-6-003-seed-payment-statuses" author="vadim">
        <insert tableName="payment_status_reference">
            <column name="code" value="PENDING"/>
            <column name="description" value="Payment waiting for processing"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>
        <insert tableName="payment_status_reference">
            <column name="code" value="PROCESSED"/>
            <column name="description" value="Payment processed successfully"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>
        <insert tableName="payment_status_reference">
            <column name="code" value="FAILED"/>
            <column name="description" value="Payment processing failed"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>
    </changeSet>
</databaseChangeLog>
